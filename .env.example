# Token from @BotFather. The colon is required; a missing colon is repaired on startup.
BOT_TOKEN=
# Telegram user id allowed to use this archive. Leave empty to allow every account
# its own private vault.
ADMIN_ID=
# Optional extra accounts, comma-separated.
ALLOWED_USER_IDS=
# Optional. On FadeHost leave this unset so the archive is stored under /data.
DATA_DIR=
